# 复制本文件为 .env 并填入自己的值。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ---------- Flask ----------
FLASK_DEBUG=1
FLASK_ENV=development
WTF_CSRF_ENABLED=False

# ---------- 数据库 ----------
# 格式：postgresql://用户名:密码@主机:端口/数据库名
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/llmops
SQLALCHEMY_ECHO=True
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600

# ---------- OpenAI ----------
# 对话与嵌入都用这个 key。使用兼容接口的第三方服务时，同时设置 OPENAI_API_BASE
OPENAI_API_KEY=
# OPENAI_API_BASE=

# ---------- Weaviate（本地 Docker）----------
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080

# ---------- Weaviate Cloud（study 目录的部分示例用，可留空）----------
WEAVIATE_CLUSTER_URL=
WEAVIATE_API_KEY=

# ---------- LangSmith 链路追踪（可选，留空则不上报）----------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="LLMOpsDev"
