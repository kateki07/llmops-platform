# 复制本文件为 .env 并填入自己的值。
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ---------- Flask ----------
FLASK_DEBUG=1
FLASK_ENV=development
WTF_CSRF_ENABLED=False

# ---------- 数据库 ----------
# 格式：postgresql://用户名:密码@主机:端口/数据库名
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/llmops
SQLALCHEMY_ECHO=True
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600

# ---------- OpenAI ----------
# 对话与嵌入都用这个 key。使用兼容接口的第三方服务时，同时设置 OPENAI_API_BASE
OPENAI_API_KEY=
# OPENAI_API_BASE=

# ---------- Weaviate（本地 Docker）----------
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080

# ---------- Weaviate Cloud（study 目录的部分示例用，可留空）----------
WEAVIATE_CLUSTER_URL=
WEAVIATE_API_KEY=

# ---------- LangSmith 链路追踪（可选，留空则不上报）----------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="LLMOpsDev"

# ---------- Redis（Celery 的队列和结果存储）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=False

# ---------- Celery 异步任务 ----------
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=False
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# ---------- 腾讯云 COS（上传文件存储）----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_SCHEME=https
COS_DOMAIN=

# ---------- 插件用的第三方 API Key ----------
GAODE_API_KEY=
SERPER_API_KEY=

# --- 第9周 授权认证 ---
# JWT 签名密钥，自己随便生成一个长随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your_jwt_secret_key

# GitHub OAuth（第三方登录），在 GitHub → Settings → Developer settings → OAuth Apps 注册
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/oauth/github/authorize

# --- 第16周 多模态与第三方平台 ---
# 后端 API 的对外前缀。两处在用：
#   1) 内置工具图标 URL；2) 展示给用户的微信公众号回调地址。
# 本地开发填后端地址；生产环境 nginx 把 UI 和 API 合在同一域名下，填 https://你的域名/api
SERVICE_API_PREFIX=http://localhost:5000
# 服务器公网 IP，填在微信公众号后台的「IP 白名单」里，仅用于前端展示提示
SERVICE_IP=

# DeepSeek（第16周扩展课时，走 OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
